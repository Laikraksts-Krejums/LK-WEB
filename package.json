    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^6.20.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.3.2",
